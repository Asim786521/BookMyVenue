generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VENUE_OWNER
  ADMIN
}

enum VenueStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role          @default(USER)
  isActive     Boolean       @default(true) @map("is_active")
  venues       Venue[]
  bookings     Booking[]
  authTokens   AuthToken[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Venue {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  name        String
  description String
  address     String
  city        String
  state       String
  pincode     String
  capacity    Int
  price       Decimal       @db.Decimal(12, 2)
  amenities   String[]
  status      VenueStatus   @default(PENDING_APPROVAL)
  owner       User          @relation(fields: [ownerId], references: [id])
  images      VenueImage[]
  slots       VenueSlot[]
  bookings    Booking[]
  approvals   VenueApprovalLog[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([city, status])
  @@map("venues")
}

model VenueImage {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  url       String?
  bytes     Bytes?
  mimeType  String?  @map("mime_type")
  venue     Venue    @relation(fields: [venueId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("venue_images")
}

model VenueSlot {
  id        String    @id @default(uuid()) @db.Uuid
  venueId   String    @map("venue_id") @db.Uuid
  label     String
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  venue     Venue     @relation(fields: [venueId], references: [id])
  bookings  Booking[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([venueId, startTime, endTime])
  @@map("venue_slots")
}

model Booking {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  venueId   String          @map("venue_id") @db.Uuid
  slotId    String          @map("slot_id") @db.Uuid
  date      DateTime        @db.Date
  amount    Decimal         @db.Decimal(12, 2)
  status    BookingStatus   @default(PENDING_PAYMENT)
  user      User            @relation(fields: [userId], references: [id])
  venue     Venue           @relation(fields: [venueId], references: [id])
  slot      VenueSlot       @relation(fields: [slotId], references: [id])
  payment   Payment?
  history   BookingHistory[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([venueId, date, slotId])
  @@index([userId, status])
  @@map("bookings")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  bookingId      String        @unique @map("booking_id") @db.Uuid
  transactionId  String?       @map("transaction_id")
  razorpayOrderId String?      @map("razorpay_order_id")
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  booking        Booking       @relation(fields: [bookingId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model BookingHistory {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @map("booking_id") @db.Uuid
  status    BookingStatus
  note      String?
  booking   Booking       @relation(fields: [bookingId], references: [id])
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("booking_history")
}

model AuthToken {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auth_tokens")
}

model VenueApprovalLog {
  id        String      @id @default(uuid()) @db.Uuid
  venueId   String      @map("venue_id") @db.Uuid
  adminId   String      @map("admin_id") @db.Uuid
  status    VenueStatus
  reason    String?
  venue     Venue       @relation(fields: [venueId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("venue_approval_logs")
}
